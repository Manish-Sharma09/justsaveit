# ---------------------------------------------------------------------------
# Just Save It — environment
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# ---------------------------------------------------------------------------

# REQUIRED. MongoDB connection string (MongoDB Atlas free tier "M0" works).
# The database name is taken from the path segment, e.g. `/q2w`.
#
# ON CLOUDFLARE WORKERS this MUST use the standard `mongodb://` scheme with
# explicit hosts. The `mongodb+srv://` scheme needs an SRV DNS lookup that
# Workers cannot perform, and the only symptom is a request that hangs until
# the runtime kills it. Convert it once with:
#     dig +short SRV _mongodb._tcp.<cluster-host>   # -> the three shard hosts
#     dig +short TXT <cluster-host>                 # -> authSource + replicaSet
# then assemble:
#     mongodb://user:pass@host1:27017,host2:27017,host3:27017/q2w
#       ?ssl=true&replicaSet=<from-TXT>&authSource=admin&retryWrites=true&w=majority
# (`ssl=true` is implied by +srv and must be stated explicitly here.)
MONGODB_URI="mongodb+srv://user:pass@cluster.example.mongodb.net/q2w?retryWrites=true&w=majority"

# REQUIRED in production. Secret used to sign unlock cookies for password-
# protected drops. Generate one with:  openssl rand -hex 32
APP_SECRET=""

# STRONGLY RECOMMENDED. Canonical origin. Used for shareable URLs and QR codes,
# and for every SEO URL the site emits: <link rel="canonical">, og:url,
# sitemap.xml and robots.txt. If this is blank the code falls back to a
# placeholder domain, and a canonical pointing at the wrong host tells search
# engines to index that host instead of yours. Set it before going live.
#   e.g. NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_URL=""

# OPTIONAL. Realtime collaboration server (Socket.IO). Leave blank to disable
# live sync — the app falls back to plain autosave and stays fully functional.
NEXT_PUBLIC_REALTIME_URL="https://justsaveit-backend.onrender.com"

# OPTIONAL. Storage driver for uploaded files: "mongo" (default) or "local".
#   mongo — chunked binary storage in the same MongoDB database. No extra
#           service, no extra cost. Bound by your cluster's storage quota.
#   local — writes to ./.data/blobs on the server filesystem. Good for
#           self-hosting; NOT suitable for serverless hosts with ephemeral disks.
STORAGE_DRIVER="mongo"

# OPTIONAL. Filesystem path for STORAGE_DRIVER=local.
LOCAL_STORAGE_DIR=".data/blobs"

# OPTIONAL limits. Defaults shown. Keep these conservative on a free cluster.
MAX_FILE_BYTES="26214400"      # 25 MB per file
MAX_DROP_BYTES="104857600"     # 100 MB per drop
MAX_FILES_PER_DROP="25"

# Google Analytics 4 measurement id (public; ships in the page source).
# Leave empty to disable analytics. Only read in production builds.
NEXT_PUBLIC_GA_ID=""
